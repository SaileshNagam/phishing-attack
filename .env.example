# PhishTrace (PhishShield) Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── VirusTotal API ─────────────────────────────────────────────────────────────
# Get your free API key from: https://www.virustotal.com/gui/my-apikey
# If not set, VirusTotal scanning will be skipped gracefully (DNS still works).
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ─── External Scan Tuning (Optional) ───────────────────────────────────────────
# How long to wait for VT URL analysis after submission (seconds, default: 8)
VT_ANALYSIS_WAIT_SECONDS=8

# How long to cache per-URL external scan results (seconds, default: 3600 = 1 hour)
EXTERNAL_SCAN_CACHE_TTL_SECONDS=3600

# ─── API Configuration ─────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
ENABLE_VIRUSTOTAL=false
ENABLE_DNS_SCAN=true

# ─── Model Configuration ───────────────────────────────────────────────────────
MODEL_PATH=results/models/

# ─── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
