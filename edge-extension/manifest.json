{
  "manifest_version": 3,
  "name": "PhishShield for Microsoft Edge",
  "version": "3.0",
  "description": "Unified AI phishing detection extension for Microsoft Edge. Connects to PhishShield Backend API.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "tabs"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://inbox.google.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8501/*",
    "http://127.0.0.1:8501/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield — Check Email",
    "default_icons": {
      "16":  "images/icon128.png",
      "48":  "images/icon128.png",
      "128": "images/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://inbox.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16":  "images/icon128.png",
    "48":  "images/icon128.png",
    "128": "images/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}
